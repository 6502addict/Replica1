# Requires cc65 toolchain installed

include ../common.mk

TARGET = bootloader

LIBS = $(LIB_DIR)/fatfs.lib $(LIB_DIR)/sdcard.lib $(LIB_DIR)/spi.lib $(LIB_DIR)/timer.lib

# Default target
all: $(TARGET).mon

$(TARGET).mon: $(TARGET).bin
	bintomon -1 -l 0x300 -r 0x300 $(TARGET).bin >$(TARGET).mon

$(TARGET).bin: $(TARGET).c $(LIBS) 
	CC65_HOME=$(CC65_HOME) cl65 -O -vm -m $(TARGET).map -o $(TARGET).bin  $(INCLUDES) -t $(TARGET) $(TARGET).c $(LIBS)

# Clean build files
clean:
	rm -f *.o *.map *.s *~ *.bin

.PHONY: all clean 




